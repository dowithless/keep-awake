    "Keep Awake: %@\nLeft-click to toggle; right-click or Control-click for the menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake: %@\nLeft-click to toggle; right-click or Control-click for the menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake：%@\n左键切换；右键或 Control＋点击打开菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake：%@\n按左鍵切換；按右鍵或按住 Control 點按以開啟選單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake：%@\n左クリックで切り替え、右クリックまたは Control＋クリックでメニューを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake: %@\n왼쪽 클릭으로 전환, 오른쪽 클릭 또는 Control-클릭으로 메뉴 열기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
