          "stringUnit": {
            "state": "translated",
            "value": "Keep Display Awake"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保持屏幕常亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時保持螢幕常亮"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のスリープも防止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이도 깨어 있게 유지"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
