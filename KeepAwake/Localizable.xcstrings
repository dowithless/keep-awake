    "System sleep ends the session; it stays off after waking.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System sleep ends the session; it stays off after waking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统睡眠后自动结束，唤醒后按需重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統睡眠後自動結束，喚醒後按需重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のスリープで終了し、復帰後は必要に応じて再度オンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기 상태가 되면 종료되며, 깨어난 뒤 필요할 때 다시 켭니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ruhezustand beendet die Sitzung; danach bei Bedarf erneut einschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille du Mac termine la session ; réactivez-la au besoin après le réveil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reposo del Mac termina la sesión; vuelve a activarla cuando la necesites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repouso do Mac encerra a sessão; reative quando precisar após despertar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон Mac завершает сеанс; после пробуждения включите снова при необходимости."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stop del Mac termina la sessione; al risveglio, riattivala quando serve."
          }
        }
      }
    },
    "Turn on Keep Awake first. The checkmark shows your saved preference.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Keep Awake first. The checkmark shows your saved preference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先开启“保持唤醒”后可调整；勾选表示已保存的偏好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟「保持喚醒」；勾選標記表示已儲存的偏好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にスリープ防止をオンにしてください。チェックマークは保存済みの設定を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 깨어 있기를 켜세요. 체크 표시는 저장된 환경설정을 나타냅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere zuerst die Wachhaltefunktion. Das Häkchen zeigt deine gespeicherte Präferenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord le maintien en éveil. La coche indique votre préférence enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa primero la función de mantener despierto. La marca muestra tu preferencia guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative primeiro a função de manter desperto. A marca indica sua preferência salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включите предотвращение сна. Флажок показывает сохранённую настройку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva prima la funzione per mantenere attivo il Mac. Il segno di spunta mostra la preferenza salvata."
          }
        }
      }
    },
    "Turns off when the Mac sleeps; turn it on again after waking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns off when the Mac sleeps; turn it on again after waking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统睡眠时自动关闭；唤醒后需重新开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統睡眠時自動關閉；喚醒後需重新開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のスリープ時にオフになります。復帰後は再度オンにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기하면 꺼집니다. 깨어난 후 다시 켜세요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Ruhezustand ausgeschaltet; danach erneut aktivieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se désactive à la veille du Mac ; réactivez après le réveil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactiva al entrar en reposo; vuelve a activarlo al despertar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa quando o Mac repousa; ative novamente ao despertar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключается при сне Mac; после пробуждения включите снова"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si disattiva quando il Mac va in stop; riattiva dopo il risveglio"
          }
        }
      }
    },
