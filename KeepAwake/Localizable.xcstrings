    "Left-click the menu bar cup to toggle Keep Awake. Right-click or Control-click to open the menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left-click the menu bar cup to toggle Keep Awake. Right-click or Control-click to open the menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左键点击菜单栏咖啡杯可切换保持唤醒。右键或 Control＋点击打开菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以滑鼠左鍵按一下選單列咖啡杯可切換保持喚醒。按右鍵或按住 Control 點按可開啟選單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのカップを左クリックするとスリープ防止を切り替えます。右クリックまたは Control＋クリックでメニューを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 컵을 왼쪽 클릭하여 깨어 있기를 전환하세요. 오른쪽 클릭 또는 Control-클릭으로 메뉴를 엽니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der linken Maustaste auf die Tasse in der Menüleiste, um die Wachhaltefunktion umzuschalten. Rechtsklick oder Control-Klick öffnet das Menü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton gauche sur la tasse dans la barre des menus pour activer ou désactiver le maintien en éveil. Un clic droit ou Contrôle-clic ouvre le menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic izquierdo en la taza de la barra de menús para activar o desactivar la función. Un clic derecho o Control-clic abre el menú."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão esquerdo na xícara da barra de menus para ativar ou desativar a função. Clique com o botão direito ou com Control para abrir o menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите левой кнопкой на чашку в строке меню, чтобы переключить предотвращение сна. Правая кнопка или Control-нажатие открывает меню."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sinistro sulla tazza nella barra dei menu per attivare o disattivare la funzione. Un clic destro o Ctrl-clic apre il menu."
          }
        }
      }
    },
