          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder aussi l’écran éveillé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener también la pantalla despierta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a Tela Desperta Também"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выключать дисплей"
          }
        },
        "it": {
