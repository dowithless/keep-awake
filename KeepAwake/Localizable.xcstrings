    "Keep Awake could not fully turn off after system sleep. Turn it off again to retry, or quit the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake could not fully turn off after system sleep. Turn it off again to retry, or quit the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统睡眠后未能完全关闭保持唤醒。请再次关闭以重试，或退出应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統睡眠後未能完全關閉保持喚醒。請再次關閉以重試，或結束應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのスリープ後、スリープ防止を完全に解除できませんでした。もう一度オフにするか、アプリを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 잠자기 후 깨어 있기를 완전히 끄지 못했습니다. 다시 끄거나 앱을 종료하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wachhaltefunktion konnte nach dem Ruhezustand nicht vollständig beendet werden. Schalte sie erneut aus oder beende die App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
