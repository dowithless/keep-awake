    "macOS has not confirmed Launch at Login. Move the app to Applications, retry, and check Login Items in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS has not confirmed Launch at Login. Move the app to Applications, retry, and check Login Items in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 尚未确认登录时启动已开启。请将应用移到“应用程序”文件夹后重试，并检查系统设置中的登录项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 尚未確認登入時啟動已開啟。請將應用程式移至「應用程式」檔案夾後重試，並檢查系統設定中的登入項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がログイン時の起動を確認していません。アプリを「アプリケーション」に移動して再試行し、システム設定のログイン項目を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 로그인 시 실행을 확인하지 않았습니다. 앱을 응용 프로그램 폴더로 이동하여 재시도하고 시스템 설정의 로그인 항목을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Start beim Anmelden nicht bestätigt. Verschiebe die App in „Programme“, versuche es erneut und prüfe die Anmeldeobjekte in den Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas confirmé l’ouverture à la connexion. Déplacez l’app dans Applications, réessayez et vérifiez les éléments d’ouverture dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no ha confirmado la apertura al iniciar sesión. Mueve la app a Aplicaciones, reintenta y revisa los ítems de inicio en Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não confirmou a abertura ao iniciar sessão. Mova o app para Aplicativos, tente novamente e confira os Itens de Início nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не подтвердила запуск при входе. Переместите приложение в папку «Программы», повторите попытку и проверьте объекты входа в Системных настройках."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha confermato l’apertura al login. Sposta l’app in Applicazioni, riprova e controlla gli elementi di login in Impostazioni di Sistema."
          }
        }
      }
    },
    "macOS has not confirmed that Launch at Login is off. Retry or check Login Items in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS has not confirmed that Launch at Login is off. Retry or check Login Items in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 尚未确认登录时启动已关闭。请重试或检查系统设置中的登录项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 尚未確認登入時啟動已關閉。請重試或檢查系統設定中的登入項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がログイン時の起動の無効化を確認していません。再試行するか、システム設定のログイン項目を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 로그인 시 실행 해제를 확인하지 않았습니다. 재시도하거나 시스템 설정의 로그인 항목을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat das Deaktivieren des Starts beim Anmelden nicht bestätigt. Versuche es erneut oder prüfe die Anmeldeobjekte in den Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas confirmé la désactivation de l’ouverture à la connexion. Réessayez ou vérifiez les éléments d’ouverture dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no ha confirmado que la apertura al iniciar sesión esté desactivada. Reintenta o revisa los ítems de inicio en Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não confirmou que a abertura ao iniciar sessão está desativada. Tente novamente ou confira os Itens de Início nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не подтвердила отключение запуска при входе. Повторите попытку или проверьте объекты входа в Системных настройках."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha confermato che l’apertura al login è disattivata. Riprova o controlla gli elementi di login in Impostazioni di Sistema."
          }
        }
      }
    }
  },
  "version": "1.0"
}
