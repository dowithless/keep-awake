    "System sleep ends the current session. After waking, turn Keep Awake on again when needed. Launch at login never starts a session automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System sleep ends the current session. After waking, turn Keep Awake on again when needed. Launch at login never starts a session automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统睡眠会结束本次保持唤醒。电脑唤醒后，需要时请重新开启。登录启动不会自动开启保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統睡眠會結束本次保持喚醒。Mac 喚醒後，需要時請重新開啟。登入啟動不會自動開啟保持喚醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがスリープすると現在のセッションは終了します。復帰後、必要に応じて再度オンにしてください。ログイン時の起動でセッションが自動開始されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 잠자기는 현재 세션을 종료합니다. 깨어난 후 필요할 때 다시 켜세요. 로그인 시 실행은 세션을 자동으로 시작하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ruhezustand beendet die aktuelle Sitzung. Aktiviere die Wachhaltefunktion nach dem Aufwachen bei Bedarf erneut. Der Start beim Anmelden beginnt nie automatisch eine Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille du système termine la session en cours. Après le réveil, réactivez le maintien en éveil si nécessaire. L’ouverture à la connexion ne démarre jamais de session automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reposo del sistema termina la sesión actual. Al despertar, activa de nuevo la función cuando la necesites. Abrir al iniciar sesión nunca inicia una sesión automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repouso do sistema encerra a sessão atual. Após despertar, ative a função novamente quando precisar. Abrir ao iniciar sessão nunca começa uma sessão automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон системы завершает текущий сеанс. После пробуждения при необходимости включите предотвращение сна снова. Запуск при входе никогда не начинает сеанс автоматически."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stop del sistema termina la sessione attuale. Al risveglio, riattiva la funzione quando serve. L’apertura al login non avvia mai una sessione automaticamente."
          }
        }
      }
    },
    "Turn on Keep Awake first. The checkmark shows your saved preference.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Keep Awake first. The checkmark shows your saved preference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先开启“保持唤醒”后可调整；勾选表示已保存的偏好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟「保持喚醒」；勾選標記表示已儲存的偏好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にスリープ防止をオンにしてください。チェックマークは保存済みの設定を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 깨어 있기를 켜세요. 체크 표시는 저장된 환경설정을 나타냅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere zuerst die Wachhaltefunktion. Das Häkchen zeigt deine gespeicherte Präferenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord le maintien en éveil. La coche indique votre préférence enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa primero la función de mantener despierto. La marca muestra tu preferencia guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative primeiro a função de manter desperto. A marca indica sua preferência salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включите предотвращение сна. Флажок показывает сохранённую настройку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva prima la funzione per mantenere attivo il Mac. Il segno di spunta mostra la preferenza salvata."
          }
        }
      }
    },
    "Turns off when the Mac sleeps; turn it on again after waking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns off when the Mac sleeps; turn it on again after waking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统睡眠时自动关闭；唤醒后需重新开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統睡眠時自動關閉；喚醒後需重新開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のスリープ時にオフになります。復帰後は再度オンにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기하면 꺼집니다. 깨어난 후 다시 켜세요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Ruhezustand ausgeschaltet; danach erneut aktivieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se désactive à la veille du Mac ; réactivez après le réveil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactiva al entrar en reposo; vuelve a activarlo al despertar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa quando o Mac repousa; ative novamente ao despertar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключается при сне Mac; после пробуждения включите снова"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si disattiva quando il Mac va in stop; riattiva dopo il risveglio"
          }
        }
      }
    },
    "Unable to Complete Operation": {
