    "Approval is pending. Click to unregister, or allow it in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval is pending. Click to unregister, or allow it in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统尚未允许；点击可取消注册，或在系统设置中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚待系統允許；按一下可取消註冊，或在系統設定中允許。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの許可待ちです。クリックで登録を解除するか、システム設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 승인을 기다리는 중입니다. 클릭하여 등록을 취소하거나 시스템 설정에서 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Genehmigung steht aus. Klicke zum Abmelden oder erlaube es in den Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation en attente. Cliquez pour désinscrire l’app ou autorisez-la dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autorización está pendiente. Haz clic para cancelar el registro o permite la app en Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação está pendente. Clique para cancelar o registro ou permita o app nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается разрешение системы. Нажмите для отмены регистрации или разрешите запуск в Системных настройках."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazione in attesa. Fai clic per annullare la registrazione oppure consenti l’app in Impostazioni di Sistema."
          }
        }
      }
    },
    "Click to toggle Keep Awake; right-click or Control-click to open the menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to toggle Keep Awake; right-click or Control-click to open the menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击切换保持唤醒；右键或 Control＋点击打开菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下切換保持喚醒；按右鍵或按住 Control 點按以開啟選單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックでスリープ防止を切り替え、右クリックまたは Control＋クリックでメニューを開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하여 깨어 있기 전환, 오른쪽 클릭 또는 Control-클릭으로 메뉴 열기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken zum Umschalten; Rechtsklick oder Control-Klick öffnet das Menü"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour activer ou désactiver ; clic droit ou Contrôle-clic pour ouvrir le menu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para activar o desactivar; clic derecho o Control-clic para abrir el menú"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para ativar ou desativar; clique com o botão direito ou Control para abrir o menu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите для переключения; правая кнопка или Control-нажатие открывает меню"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per attivare o disattivare; clic destro o Ctrl-clic per aprire il menu"
          }
        }
      }
    },
