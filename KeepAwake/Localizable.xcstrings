    "Could not disable Launch at Login: %@\nThe menu shows the current system status.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disable Launch at Login: %@\nThe menu shows the current system status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能关闭登录时启动：%@\n菜单显示系统当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法關閉登入時啟動：%@\n選單顯示系統目前的狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の起動を無効にできませんでした：%@\nメニューには現在のシステム状態が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 실행을 끌 수 없습니다: %@\n메뉴에 현재 시스템 상태가 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start beim Anmelden konnte nicht deaktiviert werden: %@\nDas Menü zeigt den aktuellen Systemstatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de désactiver l’ouverture à la connexion : %@\nLe menu indique l’état actuel du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desactivar la apertura al iniciar sesión: %@\nEl menú muestra el estado actual del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desativar a abertura ao iniciar sessão: %@\nO menu mostra o estado atual do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить запуск при входе: %@\nВ меню показано текущее состояние системы."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile disattivare l’apertura al login: %@\nIl menu mostra lo stato attuale del sistema."
          }
        }
      }
    },
    "Could not enable Launch at Login: %@\nThe menu shows the current system status.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not enable Launch at Login: %@\nThe menu shows the current system status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能开启登录时启动：%@\n菜单显示系统当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟登入時啟動：%@\n選單顯示系統目前的狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の起動を有効にできませんでした：%@\nメニューには現在のシステム状態が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 실행을 켤 수 없습니다: %@\n메뉴에 현재 시스템 상태가 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start beim Anmelden konnte nicht aktiviert werden: %@\nDas Menü zeigt den aktuellen Systemstatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’activer l’ouverture à la connexion : %@\nLe menu indique l’état actuel du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar la apertura al iniciar sesión: %@\nEl menú muestra el estado actual del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar a abertura ao iniciar sessão: %@\nO menu mostra o estado atual do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить запуск при входе: %@\nВ меню показано текущее состояние системы."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile attivare l’apertura al login: %@\nIl menu mostra lo stato attuale del sistema."
          }
        }
      }
    },
    "Could not keep the display awake (%@) or release the system assertion (%@). The Mac stays awake; the display may sleep. Turn off Keep Awake again or quit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not keep the display awake (%@) or release the system assertion (%@). The Mac stays awake; the display may sleep. Turn off Keep Awake again or quit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能开启屏幕常亮（%@），且系统断言清理失败（%@）。Mac 仍保持唤醒，显示器可休眠。请再次关闭“保持唤醒”或退出应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟螢幕常亮（%@），且無法釋放系統電源斷言（%@）。Mac 仍保持喚醒，顯示器可進入睡眠。請再次關閉「保持喚醒」或結束應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のスリープ防止（%@）とシステムアサーションの解放（%@）に失敗しました。Mac はスリープしませんが、画面はスリープできます。スリープ防止をもう一度オフにするか、アプリを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 깨우기(%@) 및 시스템 전원 어설션 해제(%@)에 실패했습니다. Mac은 깨어 있고 디스플레이는 잠자기할 수 있습니다. 깨어 있기를 다시 끄거나 앱을 종료하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Display konnte nicht wach gehalten (%@) und System-Anforderung nicht freigegeben werden (%@). Der Mac bleibt wach, das Display darf schlafen. Schalte die Wachhaltefunktion erneut aus oder beende die App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de garder l’écran éveillé (%@) et de libérer l’assertion système (%@). Le Mac reste éveillé ; l’écran peut se mettre en veille. Désactivez à nouveau le maintien en éveil ou quittez l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mantener la pantalla despierta (%@) ni liberar la aserción del sistema (%@). El Mac sigue despierto; la pantalla puede entrar en reposo. Desactiva de nuevo la función o sal de la app."
