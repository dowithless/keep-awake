          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake: %@\nClic izquierdo para activar o desactivar; clic derecho o Control-clic para el menú"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake: %@\nClique esquerdo para alternar; clique direito ou Control-clique para o menu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
