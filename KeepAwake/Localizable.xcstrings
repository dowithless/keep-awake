    "Keep your Mac awake for long tasks; let the display sleep independently.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac awake for long tasks; let the display sleep independently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间任务，让 Mac 保持唤醒；屏幕可单独休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間工作，讓 Mac 保持喚醒；螢幕可獨立睡眠。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間の作業中も Mac を起動状態に保ち、画面だけをスリープできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 작업 동안 Mac을 깨어 있게 유지하고 화면만 잠자기 상태로 둘 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deinen Mac bei langen Aufgaben wach; der Bildschirm darf unabhängig ruhen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre Mac éveillé pendant les tâches longues, tout en laissant l’écran en veille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu Mac despierto durante tareas largas y permite que la pantalla repose por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Mac acordado em tarefas longas e permita que a tela repouse separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac уснуть во время долгих задач; экран может спать отдельно."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni attivo il Mac durante le attività lunghe e lascia che lo schermo vada in stop separatamente."
          }
        }
      }
    },
